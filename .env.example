# Copy to .env.local and adjust.

# Base URL the browser calls for the Shop API (`${URL}/v1/items`, `${URL}/v1/cart`, ...).
# /shop-api is proxied by next.config.ts to SHOP_BACKEND_URL, so the cart cookie stays same-origin.
NEXT_PUBLIC_SHOP_API_URL=http://localhost:3000/shop-api
# Where the Spring Boot API runs (server-side only, used by the proxy). Default http://localhost:8080
SHOP_BACKEND_URL=http://localhost:8080

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
